{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAAA-Item-Analysis",
  "version": "2.0.0",
  "identifier": "edu.ntcu.saaa.itemanalysis",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SAAA 學生學習能力檢測 - 試題分析 (CTT) 與成績計算系統",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
